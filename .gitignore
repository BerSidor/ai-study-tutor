# This repo publishes the AI-tutor workflow itself (TUTOR.md, README.md,
# SETUP-NOTES.md, sync-tutor.ps1, .claude/skills/new-course/, EXAMPLE101/).
# Every other top-level folder is personal coursework and must never be published.

/*/
!/.claude/
!/EXAMPLE101/

# Local-only notes (real course status) — never published
/NOTES.local.md

# Junk that can show up anywhere
__pycache__/
.ipynb_checkpoints/
.venv/
venv/
.vscode/
*.db
*.pyc
